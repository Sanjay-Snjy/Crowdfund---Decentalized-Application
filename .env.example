# CrowdFund — environment variables TEMPLATE (names + where each value comes from)
# Copy to .env.local (git-ignored) for local development, and set the same names in
# your host's dashboard (Vercel → Settings → Environment Variables) for deployments.
# NEVER put a real key in this file — it is committed to git.

# ─── Network / contract (browser-visible: these end up in the client bundle) ──
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_CHAIN_SYMBOL=ETH
# Where: your RPC provider dashboard (dashboard.infura.io → API Keys, Alchemy → Apps
# → Sepolia → HTTPS). A public URL is acceptable here; the committed fallback in
# constants/index.js is used when this is unset.
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/1da513d7c5e94e52a8ba91f899602dde
NEXT_PUBLIC_BLOCK_EXPLORER=https://sepolia.etherscan.io
NEXT_PUBLIC_BLOCK_EXPLORER_NAME=Sepolia Etherscan

# ─── Server-side RPC + indexer ────────────────────────────────────────────────
# Where: your RPC provider dashboard. Use a SEPARATE key from NEXT_PUBLIC_RPC_URL so
# browser traffic cannot rate-limit the server (a shared key returns HTTP 429 and
# chain-backed endpoints answer 502 "Chain data unavailable").
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/1da513d7c5e94e52a8ba91f899602dde
# Where: same provider, for the contracts workspace only — set it in web3/.env.
NETWORK_RPC_URL=
# Where: normally leave empty. Needed only to override the committed deployment; a
# new address comes from `cd web3 && npm run deploy-sepolia` (also visible on
# Sepolia Etherscan under the deployer's transactions).
CF_CONTRACT_ADDRESS=
CF_INDEX_START_BLOCK=0                        # contract deploy block
CF_INDEX_LOOKBACK_BLOCKS=20000                # default sync window
CF_CONFIRMATIONS_REQUIRED=1                   # confirmations before a donation counts

# ─── Persistence ─────────────────────────────────────────────────────────────
# Hosted libSQL (Turso). REQUIRED on hosts with a read-only/ephemeral filesystem
# (Vercel, Netlify). When set, it takes precedence over the local SQLite file.
# Where: TURSO_DATABASE_URL = `turso db show <db> --url`,
#        TURSO_AUTH_TOKEN   = `turso db tokens create <db>`.
TURSO_DATABASE_URL=libsql://crowdfund-sanjaysnjy.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTE5MDIwMTYsImlkIjoiMDFhMTM1YWQtODEwMS03ZDAxLThjYjYtYjc1NWYzNjFmODk2Iiwia2lkIjoiOTViNEN5OFphXzRULW1WN01XODE4REZETlhndzd5M2lYQlFMeDRWTFJsRSIsInJpZCI6IjVlYzAxOTNlLWFjYzktNGVkNy04NmNhLTNiMDIxNTIxNjRjOCJ9.kJ8SsJ4687TB1yok1qPsFluLbRbj7eQImgXiym3X-Ubf_F-tpDtxHmweHlktQiF2xluYsepGNZ3pVCCa32g0DA
# Local SQLite file (development / hosts with a persistent disk).
CF_DATABASE_PATH=data/crowdfund.db

# ─── Authentication ──────────────────────────────────────────────────────────
# Where: dashboard.clerk.com → your application → API Keys. Without CLERK_SECRET_KEY
# the server cannot verify a Clerk session, so every identity endpoint answers
# 401 "Authentication required" even though the header shows you signed in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aW50ZXJuYWwta2l0dGVuLTc4LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_Xg20AOFwzI1GVujy37jQVQJdUjU35aV6J6AroyLcrL
# Where: Clerk dashboard → Webhooks → your /api/webhooks/clerk endpoint (whsec_…).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_<your-signing-secret>

# Admin allow-list — any one match grants the admin role at sign-in.
# Where:
#   CF_ADMIN_WALLET_ADDRESSES → the MetaMask address you sign in with and sign the
#                               nonce from. The deployed contract's owner() is
#                               0xB56D94C2b41084D0fb38676026a857f0be2F6507.
#   CF_ADMIN_CLERK_USER_IDS   → Clerk dashboard → Users → your user → User ID (user_…).
#   CF_ADMIN_EMAILS           → that user's plain email (the server hashes it; never
#                               paste a hash here).
CF_ADMIN_WALLET_ADDRESSES=0xB56D94C2b41084D0fb38676026a857f0be2F6507                  # comma-separated
CF_ADMIN_CLERK_USER_IDS=user_3Cza9vgzt84vxqnMeirDQNFIUID
CF_ADMIN_EMAILS=thats.me.snjy@gmail.com
# Legacy admin address — still honoured by the allow-list, keep it working.
NEXT_PUBLIC_ADMIN_ADDRESS=0xB56D94C2b41084D0fb38676026a857f0be2F6507

# ─── IPFS ────────────────────────────────────────────────────────────────────
