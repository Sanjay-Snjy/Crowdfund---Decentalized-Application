# CrowdFund — environment variables (names only, never commit real values)
# Copy to .env.local for local development and set the same names in your host.

# ─── Network / contract (browser-visible) ────────────────────────────────────
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_CHAIN_SYMBOL=ETH
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_BLOCK_EXPLORER=https://sepolia.etherscan.io
NEXT_PUBLIC_BLOCK_EXPLORER_NAME=Sepolia Etherscan
# Optional: override the deployed address committed in constants/index.js
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=        # 36-char UUID from cloud.walletconnect.com

# ─── Server-side RPC + indexer ───────────────────────────────────────────────
SEPOLIA_RPC_URL=                              # preferred RPC for the server indexer
NETWORK_RPC_URL=                              # shared with the Hardhat project
CF_CONTRACT_ADDRESS=                          # server-side override of the address
CF_INDEX_START_BLOCK=0                        # contract deploy block
CF_INDEX_LOOKBACK_BLOCKS=20000                # default sync window
CF_CONFIRMATIONS_REQUIRED=1                   # confirmations before a donation counts

# ─── Persistence ─────────────────────────────────────────────────────────────
# Hosted libSQL (Turso). REQUIRED on hosts with a read-only/ephemeral filesystem
# (Vercel, Netlify). When both are set, they take precedence over the local file.
TURSO_DATABASE_URL=libsql://crowdfund-sanjaysnjy.aws-ap-south-1.turso.io                           # libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3OTE5MDIwMTYsImlkIjoiMDFhMTM1YWQtODEwMS03ZDAxLThjYjYtYjc1NWYzNjFmODk2Iiwia2lkIjoiOTViNEN5OFphXzRULW1WN01XODE4REZETlhndzd5M2lYQlFMeDRWTFJsRSIsInJpZCI6IjVlYzAxOTNlLWFjYzktNGVkNy04NmNhLTNiMDIxNTIxNjRjOCJ9.kJ8SsJ4687TB1yok1qPsFluLbRbj7eQImgXiym3X-Ubf_F-tpDtxHmweHlktQiF2xluYsepGNZ3pVCCa32g0DA
# Local SQLite file (development / hosts with a persistent disk).
CF_DATABASE_PATH=data/crowdfund.db

# ─── Authentication ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=                             # server-side session verification
CLERK_WEBHOOK_SIGNING_SECRET=                 # /api/webhooks/clerk signature check
CF_ADMIN_WALLET_ADDRESSES=                    # comma-separated allow-list
CF_ADMIN_CLERK_USER_IDS=
CF_ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_ADDRESS=                    # legacy admin address

# ─── IPFS ────────────────────────────────────────────────────────────────────
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=
